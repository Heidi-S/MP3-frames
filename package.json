{
  "name": "mp3-frame-analysis-app",
  "version": "1.0.0",
  "private": true,
  "description": "Express API that counts MPEG-1 Layer III audio frames using a hand-written binary parser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "check-node": "node scripts/check-node.cjs",
    "predev": "npm run check-node",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run check-node",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run check-node",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run check-node",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:sample": "tsx scripts/generate-sample.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.0"
  }
}
